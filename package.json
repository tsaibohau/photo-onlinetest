{
  "name": "photo-onlinetest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.player.config.ts && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:embedded": "npm run build && node scripts/build-embedded-worker.mjs && wrangler deploy -c wrangler.embedded.toml"
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "preact": "^11.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
